+def _load_audio_file(audio_input):
+    """Load an audio file without relying on torchaudio.load/TorchCodec.
+
+    TorchAudio 2.9 routes torchaudio.load through TorchCodec. Ascend NPU
+    environments commonly use the torch/torch-npu/torchaudio stack from the
+    CANN compatibility matrix, where torchcodec may be unavailable or
+    incompatible. soundfile is already an explicit project dependency and
+    returns normalized float32 samples suitable for the existing preprocessing.
+    """
+    wav_np, sr = sf.read(audio_input, dtype="float32", always_2d=True)
+    wav = torch.from_numpy(wav_np.T).contiguous()
+    return wav, sr
+
+
+def save_audio_file(output_path, audio_data, sample_rate):
+    """Save audio without relying on torchaudio.save/TorchCodec.
+
+    soundfile expects shape (time, channels), while the project keeps tensors as
+    (channels, time). Keep PCM_16 WAV output to match the previous torchaudio
+    save path.
+    """
+    if isinstance(audio_data, torch.Tensor):
+        audio_np = audio_data.detach().cpu().float().numpy()
+    else:
+        audio_np = np.asarray(audio_data, dtype=np.float32)
+    if audio_np.ndim == 2:
+        audio_np = audio_np.T
+    elif audio_np.ndim != 1:
+        raise ValueError(f"Expected 1D or 2D audio data, got shape {audio_np.shape}")
+    sf.write(output_path, audio_np, sample_rate, subtype="PCM_16")
+
+
